@article{LIN2025104277,
title = {Painting the healthy food items attractive: The color effects on diners’ food consumption behaviors},
journal = {International Journal of Hospitality Management},
volume = {130},
pages = {104277},
year = {2025},
issn = {0278-4319},
doi = {https://doi.org/10.1016/j.ijhm.2025.104277},
url = {https://www.sciencedirect.com/science/article/pii/S0278431925002002},
author = {Pearl M.C. Lin and Wai Ching Wilson Au},
keywords = {Color, Nudging, Color temperature, Color-text congruency, Healthy dining, Restaurants},
abstract = {Color plays a crucial role in influencing individuals' decision-making process. This study explores how color temperature serves as a heuristic-based nudge to alter individuals' dining behaviors at restaurants. The findings of three experimental studies consistently demonstrate that color temperature affects individuals' perceptions of food healthiness, food tastiness, and their food consumption intentions. A cool-colored food image enhances perceptions of food healthiness and aligns with healthy dining information to influence individuals' consumption intentions. Conversely, a warm-colored food image is more effective at promoting taste-oriented food consumption. These results expand our understanding of how color influences consumer dining behaviors and offer valuable insights for hospitality practitioners to promote healthy dining through color adjustments.}
}
@article{JAISWAL2025,
title = {Polo-like kinases as immune modulators: a new frontier in cancer immunotherapy},
journal = {Trends in Cancer},
year = {2025},
issn = {2405-8033},
doi = {https://doi.org/10.1016/j.trecan.2025.08.003},
url = {https://www.sciencedirect.com/science/article/pii/S2405803325002018},
author = {Tanya Jaiswal and Gagan Chhabra and Nihal Ahmad},
keywords = {PLK, TGF-β, IFN, FAS, PD-L1},
abstract = {Cancer immunotherapy has transformed treatment but faces challenges such as immune evasion and toxicity. Polo-like kinases (PLKs), frequently dysregulated in tumors, are emerging as key immune modulators. Combining PLK inhibition with immunotherapy may overcome resistance, enhance antitumor responses, and improve clinical outcomes, offering an optimally efficient strategy for cancer treatment.}
}
