@article{HONG2024e40811,
title = {Effects of dance movement therapy on compassionate flow in nursing students: An experimental study},
journal = {Heliyon},
volume = {10},
number = {23},
pages = {e40811},
year = {2024},
issn = {2405-8440},
doi = {https://doi.org/10.1016/j.heliyon.2024.e40811},
url = {https://www.sciencedirect.com/science/article/pii/S2405844024168429},
author = {Yin-Hui Hong and Chen-Jung Chen and Shu-fen Shen and Su-Chen Fang and Mei-Ling Lin and Sheng-Miauh Huang},
keywords = {Compassion, Dance movement therapy, Nursing competence, Nursing students},
abstract = {Purpose
Only a few studies have explored how compassion is taught to nursing students. This study aimed to investigate the differences in compassionate flow among nursing students both before and after an educational intervention.
Materials and methods
This study employed a cluster randomised controlled trial design in medical schools in Taiwan. We enrolled first- and second-year nursing students. The intervention group underwent dance movement therapy, while the control group received yoga training. Compassionate flow was assessed using the Compassionate Engagement and Action Scale and the Fears of Compassion Scale.
Results
A total of 59 participants (31 in the experimental group and 28 in the control group) were included in the final statistical analysis, and an 82 % response rate was recorded. Statistically significant differences were observed in total scores on the Compassionate Engagement and Action Scales, along with compassion for self and compassion from other subscales between the experimental and control groups (p < .05). The η2 effect levels were 0.12, 0.12, and 0.09.
Conclusions
Educational training employing dance movement therapy demonstrated enhancements in self-compassion and compassion for others among first- and second-year nursing students.}
}
