@article{XYLOGIANNOPOULOS2024103842,
title = {ChatGPT paraphrased product reviews can confuse consumers and undermine their trust in genuine reviews. Can you tell the difference?},
journal = {Information Processing & Management},
volume = {61},
number = {6},
pages = {103842},
year = {2024},
issn = {0306-4573},
doi = {https://doi.org/10.1016/j.ipm.2024.103842},
url = {https://www.sciencedirect.com/science/article/pii/S0306457324002012},
author = {Konstantinos F. Xylogiannopoulos and Petros Xanthopoulos and Panagiotis Karampelas and Georgios A. Bakamitsos},
keywords = {Large language models, ChatGPT 4.0, Fake reviews, Hospitality industry, Spam detection, Artificial intelligence},
abstract = {Fake reviews corrode the trust between businesses and consumers and distort the online image of a service or a product. The problem of fake review contamination is only going to worsen with the introduction of Artificial Intelligence (AI) technologies such as Large Language Models (LLMs), that allow even novice users to massively produce fake reviews that can easily be mistaken for real. In this paper, we study a particular type of fake review attack, the AI-paraphrased reviews generated with ChatGPT 4.0. For this, we use an efficient pattern detection algorithm to quantify the similarity between the paraphrased and original reviews. We use a dataset that consists of 400 reviews spanning 20 hotels around the globe and 6000 fake reviews through Open AI API. Our results show that as the word length pattern increases, the mean similarity ratio between original (human) and AI paraphrased texts converge to 0 % while it stays above 20 % between AI-paraphrased texts. This pattern is consistent for reviews of hotels with diverse geographic locations. In this way, we introduce the importance of text similarity detection as a feature that could be incorporated to the design of future fake review detection algorithms. This method can be generalized to other applications where AI paraphrased text detection is necessary.}
}
@article{MAGNANI2025115,
title = {A mobile relational agent to enhance atrial fibrillation self-care: Primary and secondary outcomes of a randomized controlled trial},
journal = {American Heart Journal},
volume = {290},
pages = {115-128},
year = {2025},
issn = {0002-8703},
doi = {https://doi.org/10.1016/j.ahj.2025.06.009},
url = {https://www.sciencedirect.com/science/article/pii/S000287032500198X},
author = {Jared W. Magnani and Christina M. Lalama and Kaleab Z. Abebe and Danielle Ferry and Bruce L. Rollman and Michelle Q. Lancet and Everlyne Kimani and Stefán Ólafsson and Timothy Bickmore and Michael K. Paasche-Orlow},
keywords = {Atrial fibrillation, anticoagulation, medication adherence, Proportion of Days Covered, self-care, human-computer interaction},
abstract = {ABSTRACT
Background
Atrial fibrillation (AF) requires long-term adherence to oral anticoagulation and self-care.
Methods
We conducted a randomized controlled trial of a smartphone-based relational agent and heart rhythm monitor with the primary outcome of anticoagulation adherence and secondary outcomes of quality of life (QOL) and health care utilization. The trial enrolled individuals with Atrial fibrillation (AF) taking anticoagulation. Intervention participants received a smartphone-based relational agent for disease education, adherence monitoring, and self-care, and a heart rate and rhythm monitor. Attention control participants received a smartphone health education application and the same heart monitor. Participants had baseline and 4-, 8-, and 12-month visits. The primary outcome was 12-month proportion of days covered (PDC) ascertained with pharmacy claims.
Results
From January, 2020 to April, 2022, the trial enrolled 243 participants (age 70.8 ± 9.8 years; 64.2% female; 30.5% Black race). The adjusted mean PDC at 12 months in the intervention arm was 0.88 (95% Confidence Interval [CI], 0.84-0.93) and in the attention control 0.85 (95% CI, 0.81-0.90) with no difference in odds of PDC ≥ 0.80 in intervention compared to the control (Odds Ratio, 1.26 [95% CI, 0.66-2.38]). Self-reported nonadherence and QOL did not differ by study arm. The event rates for health care utilization were significantly less for intervention than attention control participants as measured by emergency room visits and hospitalizations (P < .001) and number of days hospitalized (P = .004).
Conclusion
The smartphone-based relational agent intervention did not achieve its primary endpoint of increased anticoagulation adherence but did yield decreased health care utilization.
Trial registration
ClinicalTrials.gov Identifier: NCT04075994}
}
