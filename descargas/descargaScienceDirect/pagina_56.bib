@article{MACHKOUR20251233,
title = {The Rise of Artificial Intelligence in Educational Management: A Prospective Analysis on the Role of the Virtual Educational Director},
journal = {Procedia Computer Science},
volume = {257},
pages = {1233-1238},
year = {2025},
note = {The 16th International Conference on Ambient Systems, Networks and Technologies Networks (ANT)/ the 8th International Conference on Emerging Data and Industry 4.0 (EDI40)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.03.165},
url = {https://www.sciencedirect.com/science/article/pii/S1877050925009020},
author = {Badr Machkour and Ahmed Abriane},
keywords = {artificial inteligence, educational management, educational director, virtual director},
abstract = {As artificial intelligence (AI) continues to advance in sophistication, its integration into the educational domain is becoming an increasingly tangible prospect. A comprehensive analysis is conducted on the growing impact of AI in educational management, assessing the possibility that it could replace the role of the educational director. Through a prospective approach and an exhaustive review of the scientific literature, the study examines how AI can transform the management of educational institutions by optimizing decision-making processes, enhancing administrative efficiency, and personalizing educational pathways through the analysis of large datasets. However, the intrinsic limitations of AI are highlighted, notably its inability to replicate essential human competencies such as empathy, intuition, inspiring leadership, and nuanced understanding of human interactions. Consequently, a hybrid leadership model is proposed, where AI acts as a high-performing assistant for routine tasks, while human educational directors focus on strategic and relational aspects. Thus, although AI offers significant advantages for educational management, it cannot entirely substitute for the indispensable role of the human educational director.}
}
