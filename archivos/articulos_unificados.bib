@article{LAMBERT2024230,
    abstract = {Just as fire and electricity can be, and in many ways are, of great benefit to humanity, and as the contributions elsewhere in this issue of Clinics in Dermatology have shown, artificial intelligence (AI) can be used for the ill and help in medicine. We offer several suggestions to counter some of the more egregious and obvious ones: AI-generated material that purports to be caused by humans and AI-generated material that purports to show actual people doing things that these people would not normally do. Both suggestions rely on methods already in existence to ensure public safety.},
