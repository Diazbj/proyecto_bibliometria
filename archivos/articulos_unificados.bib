    keywords = {LLMs, software documentation, prompt engineering, generative AI, user documentation},
    note = {28th International Conference on Knowledge Based and Intelligent information and Engineering Systems (KES 2024)},
    pages = {1346-1354},
    title = {Automating Software Documentation: Employing LLMs for Precise Use Case Description},
