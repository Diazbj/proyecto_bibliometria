    title = {Robot-assisted liver surgery reduces complication rates while maintaining equivalent outcome quality compared to open liver surgery},
    url = {https://www.sciencedirect.com/science/article/pii/S0748798325005955},
    volume = {51},
    year = {2025}
}

@incollection{MAFIMISEBI202696,
    abstract = {Disruptive innovation often replaces obsolete business practices with modern technology and or business models, creating fresh expectations, competitors, and business models. Entrepreneurial firms or individuals must think about configuration of factors that facilitate disruptive innovation. The vast amount of the literature in innovation and strategy rarely focus on the conditions that are both necessary and sufficient for disruptive innovation to happen. The logic of disruptive innovation is about how to alter or change the market spaces in ways that are beneficial for the consumers. Whilst disruptive innovation is beneficial, some companies find it difficult to execute because of the challenges that arise from being an incumbent and an entrant simultaneously. The implications of these puzzles of dual logics of operating as incumbent and entrant simultaneously are discussed.},
