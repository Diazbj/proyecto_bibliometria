    journal = {Clinical Microbiology and Infection},
    keywords = {Carbapenem-resistant Enterobacterales, Colonization surveillance, DTR , Gram-negative bloodstream infection, Haematological malignancies},
    number = {9},
    pages = {1579-1583},
    title = {Rectal colonization by multidrug-resistant Gram-negative bacteria and subsequent bacteraemia in haematological patients},
