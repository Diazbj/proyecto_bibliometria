    issn = {0034-5288},
    journal = {Research in Veterinary Science},
    keywords = {Resistive index, Pulsatility index, Variability, Dog, Kidney},
    pages = {105882},
    title = {Determination of the inter-observer and inter-scanner variability in the measurement of the renal resistive and renal pulsatility indices in dogs},
    url = {https://www.sciencedirect.com/science/article/pii/S003452882500356X},
    volume = {196},
    year = {2025}
}

