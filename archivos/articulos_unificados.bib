    location = {Kuala Lumpur, Malaysia},
    numpages = {6},
    pages = {100–105},
    publisher = {Association for Computing Machinery},
    series = {GAIIS '24},
    title = {Analyzing the Application and Key Factors of CycleGAN in Style Transfer between Chinese Ink Paintings and Van Gogh's Artworks},
    url = {https://doi.org/10.1145/3665348.3665367},
    year = {2024}
}

@inproceedings{10.1145/3665348.3665358,
    abstract = {Sentiment analysis technology is widely used in many fields such as network public opinion. It has important research significance in the field of natural language processing. In many network texts, sentiment analysis of each entity has always been an important issue. The traditional Bi-LSTM model has the problem of gradient explosion or excessive correction in the learning rate, which affects the convergence speed and stability of the model. In this paper, a Bi-LSTM optimization model combining progressive preheating and cosine annealing is proposed, which uses word embedding technology, word shape reduction technology and named entity recognition technology. Experiments show that our model can achieve high accuracy on both the training set and the verification set, and the loss is gradually reduced. It shows an accuracy of up to 84.13 \% in both positive and negative categories, which is significantly better than the existing baseline model. Through in-depth comparative analysis, the model shows obvious advantages in key performance indicators such as accuracy, recall rate and F1 value.},
    address = {New York, NY, USA},
    author = {Qin, Jiale and Zou, Qiufang and Zhang, Haoran and Zhang, Yongzhi and Wang, Shi},
    booktitle = {Proceedings of the 2024 International Conference on Generative Artificial Intelligence and Information Security},
    doi = {10.1145/3665348.3665358},
    isbn = {9798400709562},
    location = {Kuala Lumpur, Malaysia},
    numpages = {4},
    pages = {50–53},
    publisher = {Association for Computing Machinery},
    series = {GAIIS '24},
    title = {Research on sentiment analysis of Bi-LSTM model combining cosine annealing and multi-head attention},
    url = {https://doi.org/10.1145/3665348.3665358},
    year = {2024}
}

@inproceedings{10.1145/3665348.3665362,
    abstract = {Crowd counting in dense scenes is a crucial task in the field of computer vision that aims to estimate crowd statistics by predicting the location of heads. However, the accuracy of detection algorithms usually depends on manual precision labeling of a vast amount of data, which is less feasible in practical scene applications due to its high labeling cost. Moreover, the manual labeling process is prone to errors such as false labeling and missing labeling due to overlapping and small targets in the image. To address these challenges, this paper proposes a pseudo label generation algorithm based on semi-supervised learning for dense crowd datasets. The proposed algorithm employs the self-training method of target detection in semi-supervised learning to generate pseudo-labels offline. Furthermore, the algorithm uses existing point labels in dense crowd datasets to correct the positioning information, which significantly reduces the high labeling cost. The proposed algorithm is evaluated on three widely used benchmarks, ShanghaiTech, NWPU-Crowd, and UCF-QNRF, and the experimental results demonstrate the effectiveness of the method.},
    address = {New York, NY, USA},
    author = {Cao, Limin and Hu, Yuxia and Nian, Fudong},
    booktitle = {Proceedings of the 2024 International Conference on Generative Artificial Intelligence and Information Security},
    doi = {10.1145/3665348.3665362},
    isbn = {9798400709562},
    location = {Kuala Lumpur, Malaysia},
    numpages = {5},
    pages = {72–76},
    publisher = {Association for Computing Machinery},
    series = {GAIIS '24},
    title = {Semi-supervised Crowd Counting in Dense Scenes via Self-training},
    url = {https://doi.org/10.1145/3665348.3665362},
    year = {2024}
}

@inproceedings{10.1145/3665348.3665387,
    abstract = {The accurate decoding and intention recognition of motor imagery electroencephalogram (MI-EEG) are of great significance for the implementation of brain computer interface (BCI). However, the time non-stationary properties of MI-EEG signals and the uneven information distribution of different electrode channels pose challenges to the classification of MI-EEG. To address these challenges, we proposed a convolutional network based on channel and temporal attention (CTACNet). First, raw MI-EEG signals underwent noise reduction by common average reference. Subsequently, channel attention module was used to enhance the electrode channel information related to classification. Then, shallow spatiotemporal features of MI-EEG were extracted through convolutional neural network, and time series representations containing spatial information were output. Importantly, time attention module automatically adjusted and learned the impact of different time series on classification. Finally, deep spatiotemporal features were further extracted through time convolutional network, and fully connected layers were used to complete the classification of MI-EEG. Validation experiments based on the BCI competition IV-2a dataset showed that the proposed CTACNet achieved an average classification accuracy of 84.22\% for each subject. Compared with MBEEGSE, ETCNet, EEG-TCNet, and CNN-LSTM, there were significant improvements of 2.20\%, 9.42\%, 4.50\%, and 5.40\%, respectively. This demonstrates the potential of CTACNet in significantly enhancing MI-EEG decoding and intent recognition.},
    address = {New York, NY, USA},
    author = {Liu, Bao and Cai, Zhenxin},
    booktitle = {Proceedings of the 2024 International Conference on Generative Artificial Intelligence and Information Security},
    doi = {10.1145/3665348.3665387},
    isbn = {9798400709562},
    location = {Kuala Lumpur, Malaysia},
    numpages = {6},
    pages = {223–228},
    publisher = {Association for Computing Machinery},
    series = {GAIIS '24},
    title = {Based on channel and time attention convolutional network for motor imagery electroencephalogram decoding},
    url = {https://doi.org/10.1145/3665348.3665387},
    year = {2024}
}

@inproceedings{10.1145/3665348.3665382,
    abstract = {To ensure the safe transportation of hazardous goods while minimizing transportation costs, a multi-objective optimization method is adopted to determine the optimal driving path of hazardous goods transportation vehicles. By simplifying the quantification process of risk factors for transportation vehicles passing through densely populated areas, with the goal of minimizing the number of vehicles, the total transportation distance, and the shortest driving distance through densely populated areas, an optimization model for the transportation path problem of hazardous goods vehicles is established. A multi-objective evolutionary algorithm based on probability model is designed for the model. Taking a hazardous material transportation network with 5 transportation vehicles, 24 demand nodes, and 6 densely populated areas as an example, validate the model and algorithm. The example results show that the Pareto solution of the vehicle routing problem can be obtained using this algorithm, providing decision support for the scheduling of hazardous goods transportation vehicles.},
    address = {New York, NY, USA},
    author = {Li, Wenbo},
    booktitle = {Proceedings of the 2024 International Conference on Generative Artificial Intelligence and Information Security},
    doi = {10.1145/3665348.3665382},
    isbn = {9798400709562},
    location = {Kuala Lumpur, Malaysia},
    numpages = {7},
    pages = {194–200},
    publisher = {Association for Computing Machinery},
    series = {GAIIS '24},
    title = {Multi-objective optimization of the route problem for hazardous goods transportation},
    url = {https://doi.org/10.1145/3665348.3665382},
    year = {2024}
}

@inproceedings{10.1145/3665348.3665356,
    abstract = {Artificial Intelligence-Generated Content (AIGC) has garnered widespread attention due to its ability to automatically generate diverse and valuable digital content. Integrating with AIGC, vehicular networks are evolving as the next-generation intelligent transportation system, i.e., vehicular Metaverses, which can significantly enrich the diverse and personalized immersive experience of vehicular applications for drivers and passengers. Nevertheless, due to the high demand for AIGC services and the limited coverage of RoadSide Units (RSUs), it is still challenging to efficiently allocate RSU resources for massive vehicular users. In this paper, we propose an attribute-aware auction-based mechanism for real-time resource allocation in vehicular AIGC services, which considers both price and non-monetary attributes. In this mechanism, we first formulate the resource-attribute matching problem as a weighted bipartite graph to determine potential market participants. Then, we train an auctioneer in a double Dutch auction using Deep Reinforcement Learning (DRL) algorithms to adjust the auction clocks efficiently during the clock adjustment process. Finally, simulation results show that the proposed DRL-based auction scheme outperforms existing baseline schemes in terms of average cumulative reward, convergence speed, social welfare, and auction information exchange costs.},
    address = {New York, NY, USA},
    author = {Tong, Yongju and Kang, Jiawen and Chen, Junlong and Xu, Minrui and Yang, Helin and Xu, Minghui and Xie, Renchao and Xiong, Zehui},
    booktitle = {Proceedings of the 2024 International Conference on Generative Artificial Intelligence and Information Security},
    doi = {10.1145/3665348.3665356},
    isbn = {9798400709562},
    location = {Kuala Lumpur, Malaysia},
    numpages = {7},
    pages = {36–42},
    publisher = {Association for Computing Machinery},
    series = {GAIIS '24},
    title = {Deep Reinforcement Learning based Multi-attribute Auction Model for Resource Allocation in Vehicular AIGC Services},
    url = {https://doi.org/10.1145/3665348.3665356},
    year = {2024}
}

@inproceedings{10.1145/3665348.3665419,
    abstract = {Pedestrian detection is commonly studied using visible light (RGB) images. However, in environments with poor lighting or occlusions, the performance of object detection using RGB images tends to be subpar. In contrast, infrared (IR) images yield better results in such special circumstances. Therefore, multispectral image fusion for pedestrian detection is increasingly being adopted. While this feature interaction and fusion approach enhances features, it can also introduce background noise, preventing the model from focusing on pedestrians. To address these issues, we propose a lightweight network with Unet and attention mechanism (UANet). UANet enhances the accuracy of pedestrian detection under varying illuminance by combining the strengths of RGB-IR image pairs. In UANet, a UNet-based module is designed for extracting and reusing multi-scale features from RGB images. To further extract high-level features, we incorporate a fully connected module into the UNet-based module. For infrared images, we employ high-frequency attention and average attention to extract target features from infrared images and fuse them with RGB features. In experiments, we validate the effectiveness of UANet in improving pedestrian detection performance. We conducted tests on the KAIST dataset, yielding a result of 95.23\% mAP and 7.65\% MR.},
    address = {New York, NY, USA},
    author = {Guo, Jiaren and Huang, Zihao and Tao, Yanyun},
    booktitle = {Proceedings of the 2024 International Conference on Generative Artificial Intelligence and Information Security},
    doi = {10.1145/3665348.3665419},
    isbn = {9798400709562},
    location = {Kuala Lumpur, Malaysia},
    numpages = {5},
    pages = {420–424},
    publisher = {Association for Computing Machinery},
    series = {GAIIS '24},
    title = {Multispectral pedestrian detection based on UNet and attention mechanism},
    url = {https://doi.org/10.1145/3665348.3665419},
    year = {2024}
}

@inproceedings{10.1145/3665348.3665359,
    abstract = {This paper proposes an ensemble model integrating attention mechanism with GRU (Gated Recurrent Unit) to improve the accuracy of stock volatility predictions. The study initially utilizes the "Tushare" platform to obtain stock market data and calculates its volatility time series. Furthermore, by incorporating the attention mechanism and a bidirectional processing strategy, this paper constructs an enhanced GRU model. Experimental results indicate that this model surpasses some existing prediction methods in terms of prediction accuracy. The main contribution of this paper is to enhance the GRU model equipped with an attention mechanism by integrating various network structures to achieve more accurate and stable predictions of stock volatility.},
    address = {New York, NY, USA},
