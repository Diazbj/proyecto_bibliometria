    pages = {154–159},
    publisher = {Association for Computing Machinery},
    series = {ICETM '24},
    title = {Research on the Application of Generative Artificial Intelligence in Human-machine Cooperative Teaching},
    url = {https://doi.org/10.1145/3711403.3711425},
    year = {2025}
}

