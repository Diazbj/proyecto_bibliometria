    doi = {10.1145/3636555.3636866},
    isbn = {9798400716188},
    keywords = {Assessment, Epistemic Network Analysis, Evidence-centered Design, Generative Artificial Intelligence},
    location = {Kyoto, Japan},
    numpages = {11},
    pages = {178–188},
    publisher = {Association for Computing Machinery},
