@article{ARORA2025683,
    abstract = {Generative AI (GAI), a potential branch of artificial intelligence (AI) that generates new content or data, is swiftly revolutionizing the realm of talent management and human resources (HR). This review analyzes how GAI applies to talent management, focusing on using it in employee engagement and retention strategies and exploring insights into benefits, challenges, and applications. The paper further extends with a detailed literature review regarding the various applications of generative AI in talent management: talent identification, recruitment, training, and performance appraisal. It also considers many benefits related to implementing GAI for talent management, such as improvisation of work efficiency, personalization of employee experiences, and data-driven decision-making. In this regard, the review indicates some of the complex challenges like ethical issues, biases in algorithmic decision-making, privacy concerns, and the need to upskill HR professionals that come as a result of implementing GAI. It does so by showing current opportunities opened up for organizations that adopt GAI to optimize their talent management processes, increase employee engagement, and boost retention rates in a fast-changing digital landscape.},
    author = {Ruchika Arora and Ramesh Babu Damarla},
    doi = {https://doi.org/10.1016/j.procs.2025.03.247},
    issn = {1877-0509},
    journal = {Procedia Computer Science},
    keywords = {GAI, Talent Management, Employee Engagement, Employee Retention},
    note = {Seventh International Conference on Recent Trends in Image Processing and Pattern Recognition (RTIP2R-2024)},
    pages = {683-691},
    title = {A Review on Generative AI Powered Talent Management, Employee Engagement and Retention Strategies: Applications, Benefits, and Challenges},
