doi = {10.1145/3680530.3695455},
abstract = {This paper examines how the concept of creolization is actually applied at the current time when generative artificial intelligence(AI) is being used in the field of art. It is addressed in the following three aspects: Firstly, we discuss a notion of 'trading zone' from the perspective of 'creolization'. Secondly, we explore how the trading zone can be formulated through the generative AI-based art project &lt;New Normal Hoengseong Hoedajisori&gt;. Thirdly, we examine how the MZ generation, which is treated as a special generation in the Korean society, experiences the 'creolization' through the generative AI-based art project &lt;New Normal Hoengseong Hoedajisori&gt;.},
