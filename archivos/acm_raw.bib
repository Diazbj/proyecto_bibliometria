doi = {10.1145/3675812.3675879},
abstract = {With the rapid development of science and technology, digital English teaching resources have been widely used in the field of teaching. This paper uses CiteSpace to visually analyze academic research results, and finds that the construction of digital English teaching resources is technologically advanced, which further enhances the practicability and usability of functional English, and focuses on the universality and adaptability of language output results with students as the main body.},
booktitle = {Proceedings of the 2024 9th International Conference on Distance Education and Learning},
