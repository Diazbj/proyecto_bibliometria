keywords = {English for specific purposes, Spoken workplace corpora, Written business corpora, Professional communication},
abstract = {Corpus linguistics has provided valuable insights for research and pedagogy in English for Specific Purposes (ESP). Analysis of spoken and written corpora has yielded helpful findings regarding the vocabulary, grammar, and pragmatic skills used by language learners and professionals in various disciplines. Corpus-based studies have explored differences in linguistic choices across professional workplaces and various communicative domains. While initial challenges existed in corpus collection and analysis, innovative approaches in the past 20 years have enabled richer comparisons and more practical applications for ESP. Future directions for corpus-informed ESP research include expanding data collection to new domains and modalities, developing annotation schemes to capture pragmatic nuances, building learner corpora, conducting pedagogical pilots, leveraging technological innovations, and exploring cross-linguistic comparisons. Continued collaboration between corpus linguists, ESP experts, language educators, and workplace professionals holds promise for advancing both theoretical and practical applications of corpora in ESP.}
}
