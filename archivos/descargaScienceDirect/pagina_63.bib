publisher = {Elsevier},
year = {2025},
isbn = {978-0-443-15785-1},
doi = {https://doi.org/10.1016/B978-0-443-26629-4.00007-1},
url = {https://www.sciencedirect.com/science/article/pii/B9780443266294000071},
author = {Karlo Bojčić and Nemanja Spasenovski},
keywords = {Cultural studies, Digital media, Digital trace data, Doomscrolling, Echo chamber, Filter bubble, Generative artificial intelligence, Mass communication, Media effects, Media studies, Propaganda, Well-being},
abstract = {Media studies is an interdisciplinary field that explores the development, impact, and role of media in society. It originated in the 20th century, initially focusing on propaganda, public opinion, and media effects. Over time, it incorporated structuralist, semiotic, and cultural studies approaches, examining media’s role in shaping ideology, identity, and resistance. The digital age introduced new challenges, including platform monopolies, algorithmic control, and surveillance. With the shift from traditional broadcasting to interactive media, concerns about misinformation, digital labor, and privacy grew. Today, media studies continue to evolve, addressing ethical, regulatory, and societal implications of emerging technologies.}
}
