@article{PICON2024100019,
title = {The materiality of architecture, between the rise of the Digital Age and the advent of the Anthropocene},
journal = {Perspectives in Architecture and Urbanism},
volume = {1},
number = {2},
pages = {100019},
year = {2024},
issn = {2950-2675},
doi = {https://doi.org/10.1016/j.pau.2024.100019},
url = {https://www.sciencedirect.com/science/article/pii/S295026752400023X},
author = {Antoine Picon},
keywords = {Materiality, Materials, Digital Age, Sustainability, Anthropocene},
abstract = {This paper explores questions of materiality in contemporary architecture in light of emerging developments in the discipline, building on the author’s previous work on the subject. After presenting a conceptual distinction between matter, material, and materiality—here defined as a socially constructed, relational phenomenon—the paper examines ongoing and potential shifts in the materiality of buildings driven by the rise of digital design and the adaptation to the challenges of the Anthropocene. Key topics include the movement from form to process in contemporary design, the renewed centrality of materials, the “material turn” in the humanities and social sciences, and the return of ornament. In conclusion, architecture is described as both a medium and a regulator of the human relationship to the material world.}
}
@article{ANTHAMATTEN2024105192,
title = {Integrating Artificial Intelligence Into Virtual Simulations to Develop Entrustable Professional Activities},
journal = {The Journal for Nurse Practitioners},
volume = {20},
