@article{KELKAR2024S123,
title = {Feasibility of Utilizing a Virtual Health Assistant during Inpatient Reduced-Intensity Allogeneic Transplantation},
journal = {Transplantation and Cellular Therapy},
volume = {30},
number = {2, Supplement },
pages = {S123-S124},
year = {2024},
note = {Abstracts from the 2024 Tandem Meetings of ASTCT and CIBMTR, February 21-24, 2024, San Antonio, Texas, USA},
issn = {2666-6367},
doi = {https://doi.org/10.1016/j.jtct.2024.01.011},
url = {https://www.sciencedirect.com/science/article/pii/S2666636724000137},
author = {Amar H. Kelkar and Chantal Kerssens and Nicholas Groblewski and Dillon Clancy and Hajime Uno and Dr. Corey Cutler and Danielle Sherman-Manhard and Robert J. Soiffer and Victor HS Wang and Gregory A. Abel},
abstract = {Background
Patients undergoing inpatient allogeneic hematopoietic cell transplantation (HCT) often experience psychological consequences. care.coach AvatarTM is a tablet-based ‘human-in-the-loop’ virtual health assistant (VHA) that uses generative artificial intelligence (AI) to provide psychosocial support. It has improved loneliness, depression, anxiety, hospital delirium, and falls in older adults in the hospital (Bott, J Med Internet Res 2019).
Methods
We adapted the care.coach AvatarTM VHA for inpatient HCT. The VHA engages patients with reminders for hydration, medications, food, or activity; HCT education modules; playing games; playing the news or music; having free-form conversations; going through therapeutic activities and exercises; and practicing mindfulness and guided meditation. Avatar protocols were updated based on feedback from a structured focus group (n=10) of nurse navigators, inpatient HCT nurses, and HCT physicians at the Dana-Farber/Harvard Cancer Center. 7 HCT-specific educational modules were created. A feasibility pilot was performed in 3 sequential cohorts of 6 patients receiving reduced intensity conditioning (RIC) HCT. In the first cohort, patients were given the VHAs without any recommendations for how long to use them. The second cohort was given a recommendation for 30 minutes per day, and the third cohort was offered a $20 gift card for completion of at least 4 modules. Responses were measured through patient surveys and engagement data analysis. Predefined retention rate for feasibility was 67%, a standard for introduction of a novel AI technology (Teresi, Med Care 2022). Dissatisfaction rate for the overall VHA experience was defined as responding “disagree” or “strongly disagree” with recommending the VHA to others.
Results
The study included 18 patients (Table). Retention rate from enrollment to discharge or three weeks (whichever came first) was 78% (95% CI: 52-94%). A post-pilot survey was completed by 16 patients (90%), revealing a dissatisfaction rate of 28%. Dissatisfaction rates decreased from 50% to 20% to 0% across the 3 cohorts. Frequency of completion of the post-pilot survey for the full study was 72% within 1 week of disenrollment, and 90% overall. Average completion rate was 52% for all seven HCT modules in the whole study population. Across cohorts, module completion rates changed from 5% to 88% to 62%, reflecting guidance to patients. VHA functions by most time of usage were music (35%), exercise (20%), and education (15%; Figure).
Conclusions
The pilot study demonstrated the feasibility of implementing the care.coach AvatarTM VHA for inpatient HCT patients. Despite modest dissatisfaction and variability in completion rates, the VHA showed promise in providing HCT education, social, and emotional support for inpatient RIC HCT. Further research is needed, including the potential application for outpatient HCT.}
}
@article{ZHU2025345,
title = {Optimization Method for Spatial Element Layout of Urban Landscape Architecture Based on Generative Algorithm},
journal = {Procedia Computer Science},
volume = {261},
pages = {345-353},
year = {2025},
note = {The 5th International Conference on Machine Learning and Big Data Analytics for IoT Security and Privacy (SPIoT2024)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.04.213},
url = {https://www.sciencedirect.com/science/article/pii/S1877050925013158},
author = {Di Zhu},
keywords = {Generative Algorithm, Urban Landscape Architecture, Spatial Element Layout Optimization, Landscape Vision},
abstract = {In urban landscape design, the optimization of spatial layout is very important because it directly affects the functionality, ecological benefits and aesthetic effects of the landscape. This paper introduces a generative algorithm to optimize the layout of garden space elements. It aims to improve the rationality, aesthetics and functionality of the layout scheme through automation and intelligence, so as to better adapt to different environments and user needs. First, a geometric model of the urban landscape space is constructed, and the functional areas, green spaces, water bodies and other elements of the garden are converted into design constraints and objective functions suitable for generative algorithm processing. Then, using genetic algorithm as an optimization tool, through the iterative evolution process of the population, the position, form and combination of spatial elements are gradually adjusted to achieve the predetermined design goals. Finally, the fitness function is introduced to evaluate the pros and cons of each generation of layout schemes, including the openness of the landscape view, the coherence of the functional areas and the aesthetic evaluation. Through multiple iterations, the algorithm gradually converges to the optimal solution and provides a garden layout scheme that meets specific needs. In the layout optimization under complex terrain, the space utilization rate is between 75.0% and 77.8%. The landscape view is distributed between 66.3% and 68.0%, which is relatively evenly distributed. The urban landscape garden space element layout optimization method based on the generative algorithm introduced in this paper not only improves the design efficiency and accuracy but also provides new ideas for urban garden planning.}
}
