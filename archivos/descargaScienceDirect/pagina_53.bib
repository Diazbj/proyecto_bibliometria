@article{YU2025107880,
title = {Integrating Health Prevention, Health Education and Healthy Development: Innovative approaches to Building a Health System},
journal = {American Journal of Preventive Medicine},
volume = {69},
number = {2, Supplement 1},
pages = {107880},
year = {2025},
note = {2024 International Conference on Preventive Medicine and Nursing Science (PMNS2024), July 19-21, 2024, Qingdao, China. This supplement was sponsored by International Association of Applied Science & Engineering Technology},
issn = {0749-3797},
doi = {https://doi.org/10.1016/j.amepre.2025.107880},
url = {https://www.sciencedirect.com/science/article/pii/S074937972500371X},
author = {Juan Yu},
abstract = {Background
Aiming to explore the importance of integrating health prevention, health education and healthy development, this study analyzes four major positions: healthy living, health literacy, health maintenance and health monitoring through a literature review, and proposes strategies for building a health system. The study pointed out that integrating approaches should be centered on the “question” to enhance the health prevention of the research and incorporate it into the evaluation criteria of integrating approaches. This study helps researchers to shift from spontaneity to integrating, to conduct more insightful and relevant integrating approaches, and to promote the diversification of health improvement.
Subjects and approaches
The integrating approaches of post-positivist aapproach, hermeneutic aapproach, phenomenological aapproach and social constructionist aapproach, grounded theory and narrative research are adopted. Through in-depth interviews with interviewees' health education and health development, who were asked about their specific feelings and coping styles of health early warning and public health. Finally, the health ssystem are builded and integrating approaches are innovated.
Results
During the development of modern health science, scientific health takes the scientific nature of approaches and tools as a criterion. In order to improve the validity of research in social practice and guide the researchers from spontaneity to problem-solving in their choice of disease prevention.
Conclusions
The integrating approaches embody a progression from theoretical derivation and health prevention toward public health. The multiple approaches which combine health equity and health maintenance, and break the limitations of traditional integrating, to open up a new path for personalized health intervention.}
}
