@article{THAYER2024109457,
title = {Ovarian mass in a patient with invasive breast carcinoma: A case report of an unexpected diagnosis},
journal = {International Journal of Surgery Case Reports},
volume = {117},
pages = {109457},
year = {2024},
issn = {2210-2612},
doi = {https://doi.org/10.1016/j.ijscr.2024.109457},
url = {https://www.sciencedirect.com/science/article/pii/S2210261224002384},
author = {Maissa Ben Thayer and Ghada Sahraoui and Hassine Saber Abouda and Mahdi Farhati and Raoudha Doghri and Karima Mrad},
keywords = {Ovarian tumor, Sex cord tumor, Ovarian steroid cell tumor, Breast carcinoma},
abstract = {Introduction
Ovarian steroid cell tumors not otherwise specified (OSCT-NOS) are extremely rare ovarian sex cord stromal tumors, accounting for <0.1 % of all ovarian tumors. In 25 % of cases, they are asymptomatic leading to a delay in diagnosis. We, herein, report a singular case of OSCT-NOS diagnosed incidentally during the spread assessment of an invasive breast carcinoma of no special type (IBC-NOS). To the best of our knowledge, this is the first reported case of co-occurrence of OSCT-NOS and IBC-NOS. We aim to study the clinic-pathological characteristics of this rare tumor.
Case presentation
A 56-years old postmenopausal female, with no previous medical history, was diagnosed with an invasive IBC-NOS. The tomography performed during the spread assessment of IBC-NOS showed a suspicious mass of the right ovary. Pelvic MRI revealed an ovarian solid T1 isointense and T2 hyperintense mass. The first evoked diagnosis was an ovarian metastasis of the IBC-NOS. The patient underwent bilateral salpingo-oophorectomy. On gross examination, an ovarian solid mass measuring 2,5x2cm, with a firm gray yellowish cut surface was noted. Microscopic examination and immunostaining concluded to OSCT-NOS and ruled out the diagnosis of an ovarian metastasis of IBC-NOS.
Conclusion
OSCT-NOS are rare neoplasms. Their diagnosis might be challenging especially in absence of hormonal symptoms. A better knowledge of this rare entities would enable early diagnosis.}
}
@article{NIU2026103615,
title = {SAFedHDM: Semi-asynchronous federated learning with highlight diffusion model for medical image segmentation},
journal = {Information Fusion},
volume = {126},
pages = {103615},
year = {2026},
issn = {1566-2535},
doi = {https://doi.org/10.1016/j.inffus.2025.103615},
url = {https://www.sciencedirect.com/science/article/pii/S1566253525006876},
author = {Ke Niu and Jiuyun Cai and Xue Feng},
keywords = {Foundation model, Federated learning, Diffusion model, Medical image segmentation},
abstract = {Foundation models hold great potential for medical image segmentation, but their application depends on extensive labeled data, the collection of which is often restricted by data privacy. In response, denoising diffusion probabilistic models have been used to synthesize realistic medical images for data augmentation. Meanwhile, federated learning enables distributed training and effectively safeguards data privacy. Nevertheless, existing approaches still face challenges regarding limited feature representation and insufficient adaptability to resource heterogeneity. To address these challenges, this paper proposes a unified approach that integrates the Highlight Diffusion Model (HDM) with semi-asynchronous federated learning (SAFedHDM). In this method, the HDM is trained locally on each client to generate highlighted features, thereby guiding the optimization of the segmentation model. On the server side, a parameter cache pool is introduced, along with version-aware strategies and a model drift synchronization mechanism, to enhance model consistency and training efficiency. Extensive experiments demonstrate that the proposed method improves the Dice coefficient by 1.5% to 3.2%, while also increasing communication efficiency to 1.67 to 5 times that of synchronous federated training, thereby providing a novel paradigm for federated foundation model training in medical image segmentation.}
}
@article{PLATZ2025,
title = {Surgeon Perception of Artificial Intelligence in Thoracic Surgery: Insights from an International Survey},
journal = {The Annals of Thoracic Surgery},
year = {2025},
issn = {0003-4975},
doi = {https://doi.org/10.1016/j.athoracsur.2025.08.036},
url = {https://www.sciencedirect.com/science/article/pii/S0003497525008525},
author = {Joseph J. Platz and Darren S. Bryan and Mark K. Ferguson and Keith S. Naunheim},
abstract = {ABSTRACT
BACKGROUND
The use of artificial intelligence (AI) in medicine has increased dramatically. Its utilization will expand in cardiothoracic (CT) surgery, altering current practice. We surveyed CT surgeons to gain insight into their beliefs, hopes, and fears regarding AI.
METHODS
A 25-question instrument addressing AI use in CT surgery was created, focusing on the domains of role, value, effect, threat, and regulation of AI. In coordination with several cardiothoracic surgical societies, the survey was electronically distributed to and completed by the societies’ members. After filtering, 424 complete de-identified responses were collected and analyzed. Answers were scored on a Likert scale and collapsed into categories for analysis.
RESULTS
There was a broad range of responses that varied from very negative to very positive. Most statistically significant differences in responses among demographics primarily related to the role and value of AI in clinical care areas. Specifically, female surgeons, younger surgeons, and thoracic (as opposed to cardiac) surgeons envisioned a smaller role for AI. Physicians felt that regulation of AI should come from professional societies and federal governments, and supported a proactive approach to the integration of AI into CT surgery, including engagement with industry and sharing of specialty specific texts and databases.
CONCLUSIONS
As AI is further implemented in medicine, CT surgery faces a rapidly changing landscape. Expectedly, feelings among physicians are mixed. However, there are clear areas of agreement as to the benefit of AI integration and broad support for proactive approaches to integration.}
}
