author = {Iñaki Aldasoro and Olivier Armantier and Sebastian Doerr and Leonardo Gambacorta and Tommaso Oliviero},
keywords = {Generative artificial intelligence, Privacy, Gender},
abstract = {Data from the Survey of Consumer Expectations shows that 50% of men use generative AI tools, compared to 37% of women. Privacy concerns and perceived opportunities and risks explain a quarter of the gender gap. Respondents’ self-assessed knowledge emerges as the most important factor.}
