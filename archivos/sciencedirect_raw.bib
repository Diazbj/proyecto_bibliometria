@article{YE2024,
title = {Impact of Generative AI on Enterprise Performance in China:},
journal = {Journal of Global Information Management},
volume = {32},
number = {1},
year = {2024},
issn = {1062-7375},
doi = {https://doi.org/10.4018/JGIM.347501},
