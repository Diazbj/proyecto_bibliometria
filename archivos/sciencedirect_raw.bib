abstract = {The production of useable machine translations between the world's major languages is one of the intellectual success stories of the past 50 years. It has been made possible by shifts from rule-based approaches to statistical and then neural approaches, with generative artificial intelligence providing a series of additional functions. Although infelicities still exist and most languages do not yet have adequate electronic resources, online machine translation has become an everyday service for both lay and professional users.}
}
@article{CHEN20251247,
title = {Molecular Generation for CNS Drug Discovery and Design},
journal = {ACS Chemical Neuroscience},
