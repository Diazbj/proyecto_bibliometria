@article{JUSOH2025117825,
title = {How generative Artificial Intelligence can transform drug discovery?},
journal = {European Journal of Medicinal Chemistry},
volume = {295},
pages = {117825},
year = {2025},
issn = {0223-5234},
doi = {https://doi.org/10.1016/j.ejmech.2025.117825},
